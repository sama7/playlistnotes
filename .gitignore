# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# production artifacts
/build
/dist

# testing
/coverage
/test-results
/playwright-report
/blob-report

# environment — never commit real values; .env.example is the committed template
.env
.env.local
.env.*.local
config.env

# legacy v1 secrets, kept out of the tree while main still runs
/client/.env

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo

# Deployment staging directory: the packaged standalone build. It is
# regenerated by `npm run build` + the packaging step in the runbook, weighs
# ~200MB, and duplicates .next — it must never enter history.
/artifact/
