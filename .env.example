# Copy to .env.local for development. NEVER commit real values.
#
# The core acceptance suite must pass with NO Spotify variables set at all.
# There is deliberately no SPOTIFY_CLIENT_ID or SPOTIFY_CLIENT_SECRET here:
# v2 does not use Spotify OAuth. Track links are parsed without authentication
# and oEmbed is unauthenticated and best-effort.

# --- Database ---------------------------------------------------------------
# Local development. The database is disposable and recreated from migrations
# and seed data; it needs no backup infrastructure.
DATABASE_URL="postgresql://localhost:5432/playlistnotes_dev"
DIRECT_URL="postgresql://localhost:5432/playlistnotes_dev"

# In production DATABASE_URL points at DigitalOcean's PgBouncer pool and
# DIRECT_URL at the database directly. Migrations must not run through a
# transaction-mode pooler.
#   DATABASE_URL="postgresql://USER:PASS@HOST:25061/playlistnotes?sslmode=require&pgbouncer=true&connection_limit=5"
#   DIRECT_URL="postgresql://USER:PASS@HOST:25060/playlistnotes?sslmode=require"

# Used by the integration suite. Must be a disposable database.
TEST_DATABASE_URL="postgresql://localhost:5432/playlistnotes_test"

# --- Application ------------------------------------------------------------
# Absolute URLs are generated from this at runtime and are NEVER baked into
# stored records, so share links survive the cutover from v2.playlistnotes.io
# to the apex domain.
APP_BASE_URL="http://localhost:3100"
NODE_ENV="development"

# --- Auth (Clerk) -----------------------------------------------------------
# Development and production instances have separate keys and redirect URLs.
# Webhooks are deliberately not used: the local user row is created by lazy
# upsert on the first authenticated request.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Keep sign-in on our own domain rather than Clerk's hosted accounts.dev page.
# Without these, Clerk redirects to <instance>.accounts.dev and the local
# /sign-in route is never reached.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/account"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/account"

# --- Gating (staging only) --------------------------------------------------
# v2.playlistnotes.io is invite-gated and noindex from its first deployment.
# ⚠️ NOT IMPLEMENTED. Declared here, read by no source file — verified 2026-08-12.
# `noindex` keeps the staging host out of search results; it is NOT access
# control, and anyone with the URL can sign up today. A real server-side gate is
# required before the host is described as invite-only anywhere that matters.
REQUIRE_INVITE_CODE="true"
INVITE_CODE=""

# --- Observability (optional; only when credentials exist) ------------------
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
